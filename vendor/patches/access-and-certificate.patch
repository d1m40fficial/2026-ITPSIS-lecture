diff --git a/src/engine/access.ts b/src/engine/access.ts
new file mode 100644
index 0000000..25d05df
--- /dev/null
+++ b/src/engine/access.ts
@@ -0,0 +1,127 @@
+// Доступ к лекции по коду преподавателя и подписанный результат самопроверки.
+// В сборку попадают только хеши кодов и ключ подписи: это защищает от подмены ФИО
+// в чужом скриншоте, но не от целенаправленной подделки силами самого студента.
+export type AccessFile={
+  schemaVersion:number
+  courseId:string
+  contentVersion:string
+  certificateKey:string
+  lectures:Record<string,string[]>
+  // Хеш мастер-кода преподавателя: им снимается доступ на устройстве.
+  releaseHash?:string
+}
+export type Certificate={
+  courseId:string
+  contentVersion:string
+  lectureId:string
+  code:string
+  fullName:string
+  score:string
+  total:string
+  correct:string
+  wrong:string
+  timestamp:string
+  signature:string
+}
+const encoder=new TextEncoder()
+const alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ'
+const hex=(buffer:ArrayBuffer)=>[...new Uint8Array(buffer)].map(x=>x.toString(16).padStart(2,'0')).join('')
+export const normalizeCode=(value:string)=>value.trim().toUpperCase().replace(/[^0-9A-Z]/g,'')
+export function toBase32(bytes:Uint8Array,length:number){
+  let value=0,bits=0,out=''
+  for(const byte of bytes){value=(value<<8)|byte;bits+=8;while(bits>=5){bits-=5;out+=alphabet[(value>>>bits)&31]}}
+  if(out.length<length)out+=alphabet[(value<<(5-bits))&31]
+  return out.slice(0,length)
+}
+async function hmac(key:string,message:string){
+  const material=await crypto.subtle.importKey('raw',encoder.encode(key),{name:'HMAC',hash:'SHA-256'},false,['sign'])
+  return new Uint8Array(await crypto.subtle.sign('HMAC',material,encoder.encode(message)))
+}
+export async function hashCode(code:string){return hex(await crypto.subtle.digest('SHA-256',encoder.encode(normalizeCode(code))))}
+export function certificatePayload(file:AccessFile,hash:string,lectureId:string,fullName:string,score:string,total:string,correct:string,wrong:string,timestamp:string){
+  return [file.courseId,file.contentVersion,lectureId,hash,fullName.trim().replace(/\s+/g,' '),score,total,correct,wrong,timestamp].join('|')
+}
+export async function signCertificate(file:AccessFile,hash:string,lectureId:string,fullName:string,score:string,total:string,correct:string,wrong:string,timestamp:string){
+  return toBase32(await hmac(file.certificateKey,certificatePayload(file,hash,lectureId,fullName,score,total,correct,wrong,timestamp)),24)
+}
+export async function makeCertificate(file:AccessFile,lectureId:string,hash:string,fullName:string,score:string,total:string,correct:string,wrong:string):Promise<Certificate>{
+  const name=fullName.trim().replace(/\s+/g,' ')
+  if(name.length<5)throw Error('Укажите фамилию, имя и отчество')
+  const timestamp=new Date().toISOString()
+  return {courseId:file.courseId,contentVersion:file.contentVersion,lectureId,code:hash.slice(0,4).toUpperCase(),fullName:name,score,total,correct,wrong,timestamp,signature:await signCertificate(file,hash,lectureId,name,score,total,correct,wrong,timestamp)}
+}
+// Доступ живёт недолго: за компьютером в аудитории каждый раз может сесть другой
+// человек, и ему нужен свой код, а не чужое сохранённое имя.
+export const UNLOCK_TTL_DAYS=7
+const DAY=86_400_000
+export type Unlock={hash:string;at:number}
+export type Unlocked=Record<string,Unlock>
+const unlockKey=(base:string,id:string)=>`lecture:${base}:${id}:unlocked`
+export const identityKey=(base:string,id:string,lectureId:string)=>`lecture:${base}:${id}:identity:${lectureId}`
+export function readUnlocked(base:string,id:string):Unlocked{
+  try{
+    const raw=JSON.parse(localStorage.getItem(unlockKey(base,id))||'null')
+    if(!raw||typeof raw!=='object'||Array.isArray(raw))return{}
+    const out:Unlocked={}
+    for(const [lectureId,value] of Object.entries(raw)){
+      if(value&&typeof value==='object'&&typeof (value as Unlock).hash==='string'&&typeof (value as Unlock).at==='number')out[lectureId]=value as Unlock
+    }
+    return out
+  }catch{return{}}
+}
+export function isFreshUnlock(unlock:Unlock|undefined,ttlDays=UNLOCK_TTL_DAYS){
+  if(!unlock||typeof unlock.hash!=='string')return false
+  return Date.now()-unlock.at<ttlDays*DAY
+}
+export function rememberUnlock(base:string,id:string,lectureId:string,hash:string){
+  const current=readUnlocked(base,id)
+  try{localStorage.setItem(unlockKey(base,id),JSON.stringify({...current,[lectureId]:{hash,at:Date.now()}}))}catch{/* устройство не сохраняет: код останется только в текущей вкладке */}
+}
+// Мастер-код преподавателя снимает доступ и зафиксированное имя на устройстве.
+export async function matchReleaseCode(file:AccessFile|null,code:string){
+  if(!file||typeof file.releaseHash!=='string')return false
+  if(!normalizeCode(code))return false
+  return (await hashCode(code))===file.releaseHash
+}
+// Смена человека на устройстве: снимаем и код, и зафиксированное имя.
+export function forgetLecture(base:string,id:string,lectureId:string){
+  const current=readUnlocked(base,id)
+  delete current[lectureId]
+  try{
+    localStorage.setItem(unlockKey(base,id),JSON.stringify(current))
+    localStorage.removeItem(identityKey(base,id,lectureId))
+  }catch{/* устройство не сохраняет */}
+}
+export function requiresCode(file:AccessFile|null,lectureId:string){
+  const list=file?.lectures[lectureId]
+  return Array.isArray(list)&&list.length>0
+}
+export function isUnlocked(file:AccessFile|null,unlocked:Unlocked,lectureId:string,ttlDays=UNLOCK_TTL_DAYS){
+  if(!requiresCode(file,lectureId))return true
+  return isFreshUnlock(unlocked[lectureId],ttlDays)
+}
+export async function loadAccessFile(url:string,base:string,id:string,version:string):Promise<AccessFile|null>{
+  try{
+    const response=await fetch(`${base}${url.replace(/^\//,'')}`)
+    if(!response.ok)return null
+    const file=await response.json()as AccessFile
+    if(!file||file.schemaVersion!==1||file.courseId!==id||file.contentVersion!==version||typeof file.certificateKey!=='string'||!file.lectures)return null
+    if(file.releaseHash!==undefined&&typeof file.releaseHash!=='string')return null
+    return file
+  }catch{return null}
+}
+export async function matchAccessCode(file:AccessFile,lectureId:string,code:string){
+  const list=file.lectures[lectureId]
+  if(!Array.isArray(list)||!list.length)return ''
+  if(!normalizeCode(code))return ''
+  const hash=await hashCode(code)
+  return list.includes(hash)?hash:''
+}
+// Проверка на стороне преподавателя: сверяет подпись с кодом из своего списка.
+export async function validateCertificate(file:AccessFile,certificate:Certificate,code:string){
+  if(certificate.courseId!==file.courseId||certificate.contentVersion!==file.contentVersion)return false
+  const hash=await hashCode(code)
+  if(certificate.code!==hash.slice(0,4).toUpperCase())return false
+  const expected=await signCertificate(file,hash,certificate.lectureId,certificate.fullName,certificate.score,certificate.total,certificate.correct,certificate.wrong,certificate.timestamp)
+  return expected===certificate.signature
+}
