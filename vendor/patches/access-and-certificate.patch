+import {useState} from 'react'
+import type {Course,Lecture} from './model'
+import type {AccessFile,Certificate} from './access'
+import {identityKey,makeCertificate} from './access'
+import {downloadJson,read,save} from './storage'
+
+// ФИО привязано к лекции: «Освободить доступ» на устройстве снимает и имя.
+// Подпись покрывает имя, отпечаток кода и результат.
+export function ResultCertificate({course,base,lecture,access,codeHash,result}:{course:Course;base:string;lecture:Lecture;access:AccessFile;codeHash:string;result:{score:number;total:number;correct:number;wrong:number}}){
+  const nameKey=identityKey(base,course.id,lecture.id)
+  const [fullName,setFullName]=useState(()=>read(nameKey,'') as string)
+  const [locked,setLocked]=useState(()=>Boolean(read(nameKey,'')))
+  const [error,setError]=useState('')
+  const [certificate,setCertificate]=useState<Certificate|null>(null)
+  const [busy,setBusy]=useState(false)
+  const sign=async(e:React.FormEvent)=>{e.preventDefault();setBusy(true);setError('');try{
+    const made=await makeCertificate(access,lecture.id,codeHash,fullName,result.score.toFixed(2).replace('.',','),String(result.total),String(result.correct),String(result.wrong))
+    if(save(nameKey,made.fullName))setLocked(true)
+    setCertificate(made)
+  }catch(cause){setError(String(cause))}finally{setBusy(false)}}
+  return <section className="certificate-block">
+    <h3>Результат для преподавателя</h3>
+    <p>Введите ФИО один раз для этой лекции. Отпечаток кода надёжно указывает, чем открыт доступ; имя подсказывает, кому принадлежит результат.</p>
+    {certificate
+      ? <><dl className="certificate-grid"><div><dt>Студент</dt><dd data-testid="certificate-name">{certificate.fullName}</dd></div><div><dt>Код лекции</dt><dd>{certificate.code}</dd></div><div><dt>Баллы</dt><dd>{certificate.score} из {certificate.total}</dd></div><div><dt>Верно / с ошибкой</dt><dd>{certificate.correct} / {certificate.wrong}</dd></div><div><dt>Подпись</dt><dd data-testid="certificate-signature">{certificate.signature}</dd></div></dl><p className="field-help">Покажите преподавателю эту таблицу на экране или сделайте снимок. Для проверки подписи преподаватель может запросить файл отчёта.</p><div className="dialog-actions"><button className="button ghost" type="button" onClick={()=>downloadJson(`result-${lecture.id}.json`,certificate)}>Скачать файл отчёта</button></div></>
+      : <form onSubmit={sign} className="certificate-form"><label>ФИО студента<input autoComplete="name" disabled={locked} aria-label="ФИО студента" placeholder="Иванов Иван Иванович" value={fullName} onChange={e=>setFullName(e.target.value)}/>{locked&&<small className="field-help">ФИО зафиксировано для этой лекции на этом устройстве.</small>}</label>{error&&<p role="alert" className="task-error">{error}</p>}<div className="dialog-actions"><button className="button primary" type="submit" disabled={busy||!fullName.trim()}>{busy?'Подписываем…':'Подписать результат'}</button></div></form>}
+  </section>
+}
