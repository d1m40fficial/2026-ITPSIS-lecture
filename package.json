{
  "name": "2026-itpsis-lecture",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "generate:qr": "node scripts/generate-qr.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts tests",
    "test": "vitest run && npm run validate:content && npm run test:session && npm run prepare:notes && node --test vendor/validation/published-notes-check.mjs",
    "compile:content": "node scripts/compile-course.mjs && npm run compile:access",
    "verify:certificate": "node scripts/verify-certificate.mjs",
    "list:codes": "node scripts/list-access-codes.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:session": "node --test vendor/validation/session-check.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "spellcheck": "node scripts/spellcheck.mjs",
    "build": "npm run prepare:notes && npm run generate:guide && npm run compile:access && npm run validate:content && npm run generate:qr && tsc -b && vite build && npm run check:privacy",
    "compile:access": "node scripts/compile-access-codes.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "export:pdf": "node scripts/export-pdf.mjs",
    "check:pdf": "node scripts/check-pdf.mjs",
    "prepare:notes": "node scripts/prepare-teacher-notes.mjs",
    "generate:guide": "node scripts/generate-guide.mjs"
  },
  "dependencies": {
    "@olgakraven/lecture-engine": "file:vendor/olgakraven-lecture-engine-0.1.2-itpsis.1.tgz",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
